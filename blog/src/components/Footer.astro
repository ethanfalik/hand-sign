---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<div class="footer-brand">
			<span class="brand-name">SignLingo</span>
			<span class="tagline">Learn ASL fingerspelling, one letter at a time.</span>
		</div>
		<div class="footer-links">
			<a href="https://github.com/ethanfalik/hand-sign" target="_blank">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
				GitHub
			</a>
			<a href="/rss.xml">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
					<path
						fill="currentColor"
						d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2zm1.5 2.5c5.523 0 10 4.477 10 10a1 1 0 1 1-2 0 8 8 0 0 0-8-8 1 1 0 0 1 0-2zm0 4a6 6 0 0 1 6 6 1 1 0 1 1-2 0 4 4 0 0 0-4-4 1 1 0 0 1 0-2zm.5 7a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"
					></path>
				</svg>
				RSS
			</a>
		</div>
	</div>
	<div class="copyright">
		&copy; {today.getFullYear()} SignLingo. Open source under MIT License.
	</div>
</footer>

<style>
	footer {
		padding: 3em 1.5em;
		background: rgb(var(--gray-dark));
		color: rgba(255, 255, 255, 0.7);
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		max-width: 1200px;
		margin: 0 auto 2em;
		gap: 2em;
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}

	.brand-name {
		font-size: 1.25em;
		font-weight: 700;
		color: white;
	}

	.tagline {
		font-size: 0.9em;
		opacity: 0.8;
	}

	.footer-links {
		display: flex;
		gap: 1.5em;
	}

	.footer-links a {
		display: flex;
		align-items: center;
		gap: 0.5em;
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-links a:hover {
		color: white;
	}

	.copyright {
		text-align: center;
		font-size: 0.85em;
		padding-top: 2em;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		max-width: 1200px;
		margin: 0 auto;
	}

	@media (max-width: 720px) {
		.footer-content {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}
	}
</style>
