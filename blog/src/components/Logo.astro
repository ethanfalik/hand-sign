---
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="logo">
  <!-- Hand shape -->
  <path
    d="M50 95c-20 0-35-15-35-35V35c0-5 4-9 9-9s9 4 9 9v15c0 1 1 2 2 2s2-1 2-2V20c0-5 4-9 9-9s9 4 9 9v30c0 1 1 2 2 2s2-1 2-2V15c0-5 4-9 9-9s9 4 9 9v35c0 1 1 2 2 2s2-1 2-2V25c0-5 4-9 9-9s9 4 9 9v35c0 20-15 35-35 35z"
    fill="var(--sage, #87A878)"
    stroke="var(--accent, #5BA4A4)"
    stroke-width="2"
  />
  <!-- Fingerspelling dots -->
  <circle cx="35" cy="45" r="4" fill="var(--accent, #5BA4A4)" />
  <circle cx="50" cy="40" r="4" fill="var(--accent, #5BA4A4)" />
  <circle cx="65" cy="45" r="4" fill="var(--accent, #5BA4A4)" />
</svg>

<style>
  .logo {
    display: inline-block;
    vertical-align: middle;
  }
</style>
