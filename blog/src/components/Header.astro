---
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
---

<header>
	<nav>
		<a href="/" class="logo-link">
			<Logo size={36} />
			<span class="site-title">SignLingo</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/devlog">Dev Log</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/ethanfalik/hand-sign" target="_blank" title="GitHub">
				<span class="sr-only">SignLingo on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: var(--cream, #FBF7F0);
		border-bottom: 1px solid rgba(var(--gray), 0.1);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
	}

	.logo-link {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		padding: 0.75em 0;
	}

	.site-title {
		font-size: 1.4em;
		font-weight: 700;
		color: rgb(var(--gray-dark));
		letter-spacing: -0.02em;
	}

	.internal-links {
		display: flex;
		gap: 0.25em;
	}

	.internal-links :global(a) {
		padding: 0.75em 1em;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		border-radius: 8px;
		font-weight: 500;
		transition: background 0.2s, color 0.2s;
	}

	.internal-links :global(a:hover) {
		background: rgba(var(--gray), 0.1);
		color: var(--accent);
	}

	.internal-links :global(a.active) {
		background: var(--accent);
		color: white;
	}

	.social-links {
		display: flex;
		gap: 0.5em;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.5em;
		color: rgb(var(--gray));
		border-radius: 8px;
		transition: background 0.2s, color 0.2s;
	}

	.social-links a:hover {
		background: rgba(var(--gray), 0.1);
		color: rgb(var(--gray-dark));
	}

	@media (max-width: 720px) {
		.internal-links {
			gap: 0;
		}
		.internal-links :global(a) {
			padding: 0.75em 0.5em;
			font-size: 0.9em;
		}
		.social-links {
			display: none;
		}
	}
</style>
